{
  "mcp": {
    "servers": {
      "fin-data": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "github:CohenD/fin-data-mcp"
        ]
      },
      "searxng": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-searxng"
        ],
        "environment": {
          "SEARXNG_URL": "https://searx.be"
        }
      }
    }
  }
}